{
  "$schema": "http://json-schema.org/draft-12/schema#",
  "title": "Book",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "isbn": {
      "type": "string"
    },
    "price_vnd": {
      "type": "integer",
      "minimum": 0
    },
    "stock": {
      "type": "integer",
      "minimum": 0
    },
    "category_id": {
      "type": "integer"
    }
  },
  "required": ["title"]
}

