    {
      "name": "Bai 2 - list_books (offset, cursor, genre, multi-sort)",
      "item": [
        {
          "name": "Offset - page 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?strategy=offset&limit=5&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "strategy",
                  "value": "offset"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"items is an array\", () => pm.expect(body.items).to.be.an(\"array\"));",
                  "pm.test(\"strategy = offset\", () => pm.expect(body.strategy).to.eql(\"offset\"));",
                  "pm.test(\"has total\", () => pm.expect(body.total).to.be.a(\"number\"));",
                  "pm.test(\"at most 5 items\", () => pm.expect(body.items.length).to.be.at.most(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Offset - page 2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?strategy=offset&limit=5&offset=5",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "strategy",
                  "value": "offset"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "offset",
                  "value": "5"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"items is an array\", () => pm.expect(body.items).to.be.an(\"array\"));",
                  "pm.test(\"offset echoed back\", () => pm.expect(body.offset).to.eql(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cursor - page 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?strategy=cursor&limit=5&sort=-price,title",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "strategy",
                  "value": "cursor"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "-price,title"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"items is an array\", () => pm.expect(body.items).to.be.an(\"array\"));",
                  "pm.test(\"strategy = cursor\", () => pm.expect(body.strategy).to.eql(\"cursor\"));",
                  "pm.collectionVariables.set(\"cursor\", body.next_cursor || \"\");",
                  "pm.test(\"has next_cursor field\", () => pm.expect(body).to.have.property(\"next_cursor\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cursor - page 2 (uses next_cursor)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?strategy=cursor&limit=5&sort=-price,title&cursor={{cursor}}",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "strategy",
                  "value": "cursor"
                },
                {
                  "key": "limit",
                  "value": "5"
                },
                {
                  "key": "sort",
                  "value": "-price,title"
                },
                {
                  "key": "cursor",
                  "value": "{{cursor}}"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
