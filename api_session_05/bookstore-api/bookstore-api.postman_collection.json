{
  "info": {
    "name": "Bookstore API",
    "description": "Run the whole collection with the Collection Runner. Start the server first (python app.py). The database needs at least one category.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Lab 1 - CRUD",
      "item": [
        {
          "name": "Create book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}",
              "host": [
                "{{baseUrl}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Book\",\n  \"isbn\": \"{{isbn}}\",\n  \"price_vnd\": 120000,\n  \"stock\": 5,\n  \"category_id\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"isbn\", \"978\" + String(Date.now()).slice(-10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"bookId\", b.id);",
                  "pm.test(\"Returns the new book\", () => pm.expect(b.isbn).to.eql(pm.collectionVariables.get(\"isbn\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one book",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bookId}}"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Has the expected fields\", () => pm.expect(pm.response.json()).to.have.all.keys(\"id\", \"title\", \"isbn\", \"price_vnd\", \"stock\", \"category_id\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update book",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/{{bookId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{bookId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\",\n  \"isbn\": \"{{isbn}}\",\n  \"price_vnd\": 150000,\n  \"stock\": 5,\n  \"category_id\": {{categoryId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Price updated\", () => pm.expect(pm.response.json().price_vnd).to.eql(150000));"
                ]
              }
            }
          ]
        },
