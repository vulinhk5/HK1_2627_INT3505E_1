                  "pm.test(\"at most 5 items\", () => pm.expect(body.items.length).to.be.at.most(5));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter by genre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?genre={{genre}}&sort=-price,title&limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "genre",
                  "value": "{{genre}}"
                },
                {
                  "key": "sort",
                  "value": "-price,title"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"items is an array\", () => pm.expect(body.items).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sort single key: price ascending",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?sort=price&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "price"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"items is an array\", () => pm.expect(body.items).to.be.an(\"array\"));",
                  "const prices = body.items.map(b => b.price_vnd);",
                  "pm.test(\"prices ascending\", () => pm.expect(prices).to.eql([...prices].sort((a, b) => a - b)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sort multi-key: -price,title",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?sort=-price,title&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "key": "sort",
                  "value": "-price,title"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"items is an array\", () => pm.expect(body.items).to.be.an(\"array\"));",
                  "const prices = body.items.map(b => b.price_vnd);",
                  "pm.test(\"prices descending\", () => pm.expect(prices).to.eql([...prices].sort((a, b) => b - a)));"
                ]
              }
            }
          ]
        }
      ]
